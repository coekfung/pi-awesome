{
  "name": "pi-awesome",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "scripts": {
    "check": "tsc -p tsconfig.json --noEmit && prettier --check .",
    "check:fix": "prettier --write . && npm run check",
    "test": "node --test"
  },
  "keywords": [
    "pi-package"
  ],
  "pi": {
    "extensions": [
      "./perf/perf.ts",
      "./nono/nono.ts",
      "./notebook-edit/notebook-edit.ts",
      "./mcp/mcp.ts",
      "./quota/quota.ts"
    ]
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "lru-cache": "^11.5.2"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^0.85.1",
    "@earendil-works/pi-coding-agent": "^0.85.1",
    "@earendil-works/pi-tui": "^0.85.1",
    "@types/node": "^22.0.0",
    "prettier": "^3.5.0",
    "typebox": "1.3.7",
    "typescript": "^5.8.0"
  }
}
